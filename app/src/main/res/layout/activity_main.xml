<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:fontFamily="sans-serif-black"
        android:text="Calculadora IMC"
        android:textSize="32sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/peso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:layout_marginStart="56dp"
        android:text="Peso"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/titulo"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/introducirPeso"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="150dp"
        android:hint="Tu peso"
        android:inputType="numberDecimal"
        android:textSize="22sp"
        app:layout_constraintBaseline_toBaselineOf="@id/peso"
        app:layout_constraintStart_toStartOf="@id/peso" />

    <TextView
        android:id="@+id/altura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Altura"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/peso"
        app:layout_constraintStart_toStartOf="@id/peso" />

    <EditText
        android:id="@+id/introducirAltura"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:hint="Tu altura"
        android:inputType="numberDecimal"
        android:textSize="22sp"
        app:layout_constraintBaseline_toBaselineOf="@id/altura"
        app:layout_constraintStart_toStartOf="@id/introducirPeso" />

    <RadioGroup
        android:id="@+id/rgUnidades"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        android:checkedButton="@+id/rbMetrico"
        app:layout_constraintTop_toBottomOf="@id/introducirAltura"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/rbEspanol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S. ESPAÑOL (kg, cm)" />

        <RadioButton
            android:id="@+id/rbInglés"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="S. Inglés (lb, in)" />

    </RadioGroup>

    <Button
        android:id="@+id/calcular"
        android:layout_width="140dp"
        android:layout_height="70dp"
        android:layout_marginTop="40dp"
        android:text="Calcular"
        android:textSize="18sp"
        app:backgroundTint="#FF294573"
        app:layout_constraintTop_toBottomOf="@id/rgUnidades"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/resultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text=""
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/calcular"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>